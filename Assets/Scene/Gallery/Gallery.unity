  m_Script: {fileID: 11500000, guid: c9d52e811169e234b996c7a3d9272a3f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue: {fileID: 91567674}
  TextToBeShown:
  - "May 27th 1961: The Prime Minister of Malaya, Tunku Abdul Rahman, puts forward
    the \u2018Malaysia Proposal\u2019."
  - '1962: Public opinion polls (e.g. the Cobb Committee''s assessment in Sabah and
    Sarawak) showed majority support for Malaysia''s membership.'
  - 'July 9th 1963: Malaysia Agreement signed by Britain, Malaya, Singapore, Sabah
    and Sarawak.'
  - 'September 16th 1963: Malaysia was formally established  Malaya, Singapore, Sabah
    and Sarawak formed the Federation of Malaysia.'
  - Singapore withdrew on 9 August 1965 and became an independent state.
  - Until today, Malaysia history is still being written.
  viewDistance: 7
