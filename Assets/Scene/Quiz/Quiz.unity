  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::QuizManager
  QnA:
  - Question: Who is known as the Father of Independence of Malaya?
    Answer:
    - Tun Razak
    - Tun Dr. Ismail
    - Tunku Abdul Rahman
    - Tun V.T. Sambanthan
    CorrectAns: 3
  - Question: 'When was Tunku Abdul Rahman born?  '
    Answer:
    - January 1, 1900
    - February 8, 1903
    - August 31, 1957
    - October 10, 1945
    CorrectAns: 2
  - Question: 'Where did Tunku Abdul Rahman study law?  '
    Answer:
    - Oxford University
    - University of Malaya
    - Harvard University
    - University of Cambridge
    CorrectAns: 4
  - Question: 'When did Japan invade Malaya?  '
    Answer:
    - 1939
    - 1940
    - 1941
    - 1945
    CorrectAns: 3
  - Question: 'When did Singapore fall to Japan? '
    Answer:
    - January 1942
    - February 1942
    - March 1943
    - August 1945
    CorrectAns: 2
  - Question: 'When did Japan surrender and leave Malaya? '
    Answer:
    - 1944
    - 1945
    - 1946
    - 1950
    CorrectAns: 2
  - Question: 'What policy did the British introduce in 1945 that caused protests?  '
    Answer:
    - New Economic Policy
    - Malaysia Proposal
    - Malayan Union
    - Emergency Act
    CorrectAns: 3
  - Question: 'How did Tunku Abdul Rahman suggest people oppose the Malayan Union?  '
    Answer:
    - Armed rebellion
    - Violent protests
    - Peaceful opposition
    - Leave the country
    CorrectAns: 3
  - Question: 'Which political party turned to armed struggle against the British?  '
    Answer:
    - UMNO
    - MCA
    - MIC
    - Malayan Communist Party
    CorrectAns: 4
  - Question: 'Who was the British Prime Minister who agreed to grant independence?  '
    Answer:
    - Winston Churchill
    - Anthony Eden
    - Margaret Thatcher
    - Tony Blair
    CorrectAns: 2
  - Question: 'When was the Merdeka Agreement signed?  '
    Answer:
    - August 31, 1957
    - February 8, 1956
    - July 9, 1963
    - October 10, 1945
    CorrectAns: 2
  - Question: "When is Malaysia\u2019s Independence Day?  "
    Answer:
    - September 16, 1963
    - August 31, 1957
    - February 8, 1956
    - May 27, 1961
    CorrectAns: 2
  - Question: 'Where did the independence ceremony take place?  '
    Answer:
    - Merdeka Square
    - Putrajaya
    - Johor Bahru
    - Penang
    CorrectAns: 1
  - Question: "How many times did Tunku shout \u201CMerdeka\u201D?  "
    Answer:
    - 3 times
    - 5 times
    - 7 times
    - 10 times
    CorrectAns: 3
  - Question: 'When was Malaysia officially formed?  '
    Answer:
    - August 31, 1957
    - July 9, 1963
    - September 16, 1963
    - August 9, 1965
    CorrectAns: 3
  - Question: 'Which region left Malaysia in 1965?  '
    Answer:
    - Sabah
    - Sarawak
    - Brunei
    - Singapore
    CorrectAns: 4
